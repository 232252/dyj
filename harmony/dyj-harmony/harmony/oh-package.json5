{
  "name": "dyj-harmony",
  "description": "dyj 局域网打印共享 · 鸿蒙接收端",
  "version": "1.0.0",
  "modelVersion": "5.0.0",
  "license": "MIT",
  "repository": {},
  "dependencies": {
    // 用 release har（预编译 .so），不从源码编译 RNOH 的 C++：
    // 源码 har 会连带编译 folly/boost/RN core，耗时不可控且易失败。
    // 换 RNOH 版本时这里要跟着改，详见 harmony/README.md。
    "@rnoh/react-native-openharmony": "file:../node_modules/@react-native-oh/react-native-harmony/react_native_openharmony_release.har",
  },
  "devDependencies": {
    "@ohos/hypium": "1.0.6",
  },
  "overrides": {
    "@rnoh/react-native-openharmony": "file:../node_modules/@react-native-oh/react-native-harmony/react_native_openharmony_release.har",
  },
}
