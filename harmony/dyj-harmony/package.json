{
  "name": "dyjHarmony",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-rnoh-cli.mjs",
    "start": "react-native start --host 127.0.0.1",
    "test": "jest",
    "lint": "eslint .",
    "harmony": "react-native run-harmony --no-packager",
    "harmony:init": "react-native init-harmony --app-name dyjHarmony --bundle-name com.dyj.app",
    "harmony:link": "react-native link-harmony",
    "harmony:bundle": "react-native bundle-harmony",
    "harmony:codegen": "react-native codegen-harmony --cpp-output-path ./harmony/entry/src/main/cpp/generated --ets-output-path ./harmony/entry/src/main/ets/generated --project-root-path ."
  },
  "dependencies": {
    "@react-native-oh/react-native-harmony": "0.84.5",
    "react": "19.2.3",
    "react-native": "0.84.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-oh/react-native-harmony-cli": "0.84.5",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "harmony": {
    "codegenConfig": {
      "version": 1,
      "specPaths": [
        "~/src/specs"
      ]
    }
  }
}
