# dyj LAN printer sharing — packaged unit (vendor slot:
# /usr/lib/systemd/system). Local overrides belong in
# /etc/systemd/system/dyj.service.d/*.conf ("systemctl edit dyj").
#
# Hardening: dyj binds only high ports (6631/5353 — no
# CAP_NET_BIND_SERVICE needed) and writes only its StateDirectory, so
# it runs under a dedicated system user with an empty capability
# bounding set. Custom -spool/-out paths need a drop-in
# ReadWritePaths= override.
#
# avahi coexistence (ADR-0016): when avahi owns port 5353, dyj publishes
# through it over the system D-Bus. Two requirements:
#   - A STATIC user (not DynamicUser): dbus authenticates peers by UID
#     via SO_PEERCRED and resets connections from transient DynamicUser
#     UIDs ("connection reset by peer"). The dyj user is created by the
#     package postinstall.
#   - BindReadOnlyPaths=/run/dbus: ProtectSystem=strict hides /run.
# Without avahi, dyj falls back to its own mDNS responder.

[Unit]
Description=dyj LAN printer sharing (IPP Everywhere + mDNS)
Documentation=https://github.com/232252/dyj
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/dyj service run
Restart=on-failure
RestartSec=5
User=dyj
Group=dyj
StateDirectory=dyj
NoNewPrivileges=yes
ProtectSystem=strict
BindReadOnlyPaths=/run/dbus
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
